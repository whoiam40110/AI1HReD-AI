local function addMessage(sender, text, isAI)

	local container = Instance.new("Frame")
	container.Size = UDim2.new(1, -10, 0, 0)
	container.AutomaticSize = Enum.AutomaticSize.Y
	container.BackgroundTransparency = 1
	container.Parent = messages

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, 0, 0, 22)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = sender
	nameLabel.TextColor3 = isAI and RED or GRAY
	nameLabel.TextSize = 14
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = container

	local message = Instance.new("TextLabel")
	message.Size = UDim2.new(1, -10, 0, 0)
	message.Position = UDim2.new(0, 5, 0, 25)
	message.AutomaticSize = Enum.AutomaticSize.Y
	message.BackgroundColor3 = isAI and LIGHT_DARK or Color3.fromRGB(20, 20, 20)
	message.BorderSizePixel = 0
	message.Text = text
	message.TextColor3 = WHITE
	message.TextSize = 15
	message.Font = Enum.Font.Gotham
	message.TextWrapped = true
	message.TextXAlignment = Enum.TextXAlignment.Left
	message.TextYAlignment = Enum.TextYAlignment.Top
	message.Parent = container

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 10)
	padding.PaddingRight = UDim.new(0, 10)
	padding.PaddingTop = UDim.new(0, 8)
	padding.PaddingBottom = UDim.new(0, 8)
	padding.Parent = message

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = message
end

