--==================================================
-- CHAT SYSTEM
--==================================================

local chats = {}
local currentChat = nil
local chatNumber = 0

local function clearMessages()
	for _, child in ipairs(messages:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
end

local function createChat()
	chatNumber += 1

	local chat = {
		name = "New Chat " .. chatNumber,
		messages = {}
	}

	table.insert(chats, chat)
	currentChat = chat

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, 0, 0, 38)
	button.BackgroundColor3 = LIGHT_DARK
	button.BorderSizePixel = 0
	button.Text = chat.name
	button.TextColor3 = WHITE
	button.TextSize = 14
	button.Font = Enum.Font.Gotham
	button.TextXAlignment = Enum.TextXAlignment.Left
	button.Parent = chatList

	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 10)
	padding.Parent = button

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 7)
	corner.Parent = button

	button.MouseButton1Click:Connect(function()
		currentChat = chat
		chatTitle.Text = chat.name

		clearMessages()

		for _, msg in ipairs(chat.messages) do
			addMessage(msg.sender, msg.text, msg.isAI)
		end
	end)

	return chat
end

local function addChatMessage(sender, text, isAI)

	if not currentChat then
		return
	end

	table.insert(currentChat.messages, {
		sender = sender,
		text = text,
		isAI = isAI
	})

	addMessage(sender, text, isAI)
end

--==================================================
-- SEND MESSAGE
--==================================================

local function sendMessage()

	local text = input.Text

	if text == "" then
		return
	end

	if not currentChat then
		createChat()
	end

	input.Text = ""

	addChatMessage(PLAYER_NAME, text, false)

	-- Temporary response
	task.delay(0.5, function()

		addChatMessage(
			AI_NAME,
			"Hello, MR.ReD23! I received your message: " .. text,
			true
		)

	end)
end

send.MouseButton1Click:Connect(sendMessage)

input.FocusLost:Connect(function(enterPressed)

	if enterPressed then
		sendMessage()
	end

end)

newChat.MouseButton1Click:Connect(function()

